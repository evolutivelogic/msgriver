[Unit]
Description=MsgRiver durable message service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=msgriver
Group=msgriver
StateDirectory=msgriver
StateDirectoryMode=0700
ExecStart=/usr/local/bin/msgriver serve --state-dir /var/lib/msgriver --socket /var/lib/msgriver/msgriver.sock --ntfy-url https://ntfy.example.net --ntfy-topic operations
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/msgriver

[Install]
WantedBy=multi-user.target
